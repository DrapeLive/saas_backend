# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# Database (PostgreSQL — Neon/Supabase/RDS)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# S3-compatible object storage — file/media uploads
# Works with Neon Storage, Cloudflare R2, MinIO, or real AWS S3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_REGION=us-east-2
# Leave blank for real AWS S3; set for S3-compatible providers.
AWS_ENDPOINT_URL_S3=

# CORS — comma-separated frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email (SMTP)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# GST Verification API (ClearTax / MasterGST)
GST_API_KEY=

# WhatsApp Business Cloud API
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# Tally ERP (on-premise gateway URL)
TALLY_URL=http://localhost:9000
TALLY_USERNAME=
TALLY_PASSWORD=

# Celery / Redis (background tasks)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
