# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# Database (PostgreSQL — Neon/Supabase/RDS)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Backblaze B2 object storage — file/media uploads (S3-compatible)
B2_KEY_ID=your-application-key-id
B2_APPLICATION_KEY=your-application-key
# Optional label for the key (not used by the S3 API).
B2_KEY_NAME=
B2_BUCKET_NAME=your-bucket-name
B2_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
# The conventional AWS_* names below are kept as a fallback and are also
# sufficient for real AWS S3 or other S3-compatible providers (R2, MinIO, ...).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_REGION=us-east-2
# AWS_ENDPOINT_URL_S3=https://s3.us-east-005.backblazeb2.com

# CORS — comma-separated frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email (SMTP)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# GST Verification API (ClearTax / MasterGST)
GST_API_KEY=

# WhatsApp Business Cloud API
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# Tally ERP (on-premise gateway URL)
TALLY_URL=http://localhost:9000
TALLY_USERNAME=
TALLY_PASSWORD=

# Celery / Redis (background tasks)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Order draft lifecycle (seconds)
ORDER_DRAFT_TTL_SECONDS=2700
ORDER_EMPTY_DRAFT_TTL_SECONDS=2700

# Firebase Cloud Messaging (push notifications)
# Provide the service-account credentials as a single-line JSON string, or as a
# file path via FIREBASE_CREDENTIALS_PATH. Never commit real credentials.
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...",...}
# FIREBASE_CREDENTIALS_PATH=/absolute/path/to/service-account.json
NOTIFICATIONS_PUSH_ENABLED=True
