meta {
  name: Signup
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/auth/signup
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@company.com",
    "password": "Test@12345678",
    "full_name": "Admin User",
    "phone": "9876543210",
    "company_name": "Acme Corp",
    "company_slug": "acme-corp"
  }
}

vars:pre-request {
  base_url: http://localhost:8000
}
